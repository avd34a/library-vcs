books = ["Война и мир", "Мастер и Маргарита", "Идиот", "Евгений Онеегин"]
readers = {}

def show_books():
    for b in books:
        print(b)

def add_book(name):
    books.append(name)

def issue_book(name, reader):
    if name in books:
        books.remove(name)
        readers[reader] = name
        print(reader, "взял книгу", name)
    else:
        print("Книги нет в наличии")

def return_book(reader):
    name = readers.pop(reader)
    books.append(name)

show_books()
def find_book(name):
    if name in books:
        print("Книга найдена:", name)
        return True
    print("Книга не найдена:", name)
    return False

def count_books():
    return len(books)

def show_readers():
    for reader, book in readers.items():
        print(reader, "->", book)

print("Всего книг в наличии:", count_books())
find_book("Война и мир")
